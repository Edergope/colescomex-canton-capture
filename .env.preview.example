# Vista previa AISLADA (no producción). Copiar a .env.preview.local (no se versiona).
VITE_INSTANCE=preview
VITE_AUTH_MODE=google
VITE_SYNC_MODE=google
VITE_ALLOWED_USERS=EDR:Eder:<email>,HCT:Héctor:<email>
# Cliente OAuth de PRUEBA (recomendado: un cliente distinto al de producción, con el origen https://<proyecto>.pages.dev)
VITE_GOOGLE_CLIENT_ID=
# Recursos de PRUEBA (copias vacías; NUNCA los de producción)
VITE_DRIVE_EVIDENCE_FOLDER_ID=
VITE_DRIVE_ORIGINALS_FOLDER_ID=
VITE_SHEETS_SPREADSHEET_ID=
VITE_SHEETS_TAB_NAME=CAPTURA_FASE2_PRUEBA
# IDs de PRODUCCIÓN que esta instancia debe BLOQUEAR (la app y el script de despliegue se niegan a usarlos)
VITE_PRODUCTION_SPREADSHEET_ID=
VITE_PRODUCTION_DRIVE_FOLDER_ID=
VITE_PRODUCTION_ORIGINALS_FOLDER_ID=
VITE_PHASE1_SPREADSHEET_ID=
VITE_OCR_ENGINE=paddle
VITE_SCANNER=on
