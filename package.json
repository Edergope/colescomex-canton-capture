{
  "name": "colescomex-canton-capture",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "COLESCOMEX — Canton Fair Capture (Fase 2, China 2026). PWA offline-first de captura de proveedores.",
  "scripts": {
    "setup:assets": "node scripts/fetch-ocr-assets.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ocr:fixtures": "node ocr-eval/make-fixtures.mjs",
    "ocr:eval": "node ocr-eval/run-eval.mjs",
    "verify:google": "node scripts/verify-google-live.mjs",
    "deploy": "node scripts/deploy-pages.mjs",
    "deploy:dry-run": "node scripts/deploy-pages.mjs --dry-run",
    "scanner:fixtures": "node --import tsx ocr-eval/make-scanner-fixtures.ts",
    "scanner:eval": "node ocr-eval/run-scanner-eval.mjs",
    "scanner:before-after": "node --import tsx scripts/before-after.ts",
    "check:private": "node scripts/check-private-data.mjs",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4"
  },
  "devDependencies": {
    "@paddleocr/paddleocr-js": "^0.4.2",
    "@playwright/test": "^1.64.1",
    "@types/pngjs": "^6.0.5",
    "fake-indexeddb": "^6.2.6",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.3",
    "onnxruntime-web": "^1.24.3",
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
