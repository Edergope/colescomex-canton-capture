# Copiar a .env.local. Ninguna de estas variables es secreta (todas llegan al navegador).
# NUNCA colocar aquí client_secret, claves privadas de cuentas de servicio ni tokens.

# mock | google   (mock = desarrollo/pruebas, sin red)
VITE_AUTH_MODE=mock
# mock | google
VITE_SYNC_MODE=mock

# Usuarios autorizados: id:Nombre:email (separados por coma). El email solo se usa con AUTH_MODE=google.
VITE_ALLOWED_USERS=EDR:Eder:eder@example.com,HCT:Héctor:hector@example.com

# OAuth 2.0 Client ID (tipo "Aplicación web") — público por diseño, no es un secreto.
VITE_GOOGLE_CLIENT_ID=
# ID de la carpeta de Drive EVIDENCIAS_FASE2 (Colescomex/04_LIVE_OPERATIONS/03_SUPPLIERS/2026_CANTON_FAIR/EVIDENCIAS_FASE2)
VITE_DRIVE_EVIDENCE_FOLDER_ID=
# ID del Spreadsheet de Fase 2 (NO el de Fase 1) y nombre de la pestaña
VITE_SHEETS_SPREADSHEET_ID=
VITE_SHEETS_TAB_NAME=CAPTURA_FASE2
# Salvaguarda: ID del archivo de Fase 1 (COLESCOMEX_Canton_Fair_Fase1_Importacion). Si coincide con el de Fase 2, se bloquea la sincronización.
VITE_PHASE1_SPREADSHEET_ID=
# RESPALDO RESTRINGIDO de originales (OBLIGATORIO con Google y escáner): carpeta separada de EVIDENCIAS_FASE2,
# compartida solo con Eder, Héctor y auditoría, p. ej. …/2026_CANTON_FAIR/ORIGINALES_FASE2. Recibe todas las fotos
# originales de tarjetas (sin recortar); la carpeta del proveedor recibe la tarjeta limpia.
VITE_DRIVE_ORIGINALS_FOLDER_ID=
# production | preview (instancia aislada: base de datos propia y bloqueo de recursos de producción)
VITE_INSTANCE=production
# Smart Document Scanner (recorte + orientación): on | off
VITE_SCANNER=on
# paddle | tesseract | remote | mock
VITE_OCR_ENGINE=paddle
# Solo con VITE_OCR_ENGINE=remote: backend propio (la clave de Vision vive en el servidor)
VITE_OCR_REMOTE_URL=
